# jira-dash config — TEMPLATE / SEED
#
# The live config is `config.local.yml`, which .gitignore keeps out of the
# repository: a JQL names project keys, and a section can name a sprint. Copy
# this file to config.local.yml, edit it, and symlink it to where jira-dash
# looks:
#
#   cp config.yml.example config.local.yml
#   ln -s "$PWD/config.local.yml" ~/.config/jira-dash/config.yml
#
# Filters are raw JQL, so anything you can build in the Jira web UI can be
# pasted here verbatim.

# Always end a JQL with ORDER BY. Jira's implicit order groups by project, so
# a section whose total exceeds its limit silently drops whole projects off the
# bottom rather than the oldest issues - measured on a 63-issue section, where
# every issue of one project sat past row 20.
jiraSections:
  - title: My Issues
    jql: assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC
    limit: 20
  - title: Reported by me
    jql: reporter = currentUser() AND statusCategory != Done ORDER BY updated DESC
    limit: 20
  # Add company-specific sections in config.local.yml, not here:
  #
  #   - title: Current Sprint
  #     jql: >-
  #       project = ABC AND sprint in openSprints() AND statusCategory != Done
  #       ORDER BY updated DESC
  #     limit: 30
  #     # A board often runs several teams' sprints at once, and JQL cannot pick
  #     # one out by name: the sprint field has no LIKE operator, and `sprint ~`
  #     # was measured returning 2 of a 15-issue sprint. sprintPrefix keeps only
  #     # issues in an *active* sprint whose name starts with this string, so a
  #     # board that renames its sprint every iteration ("Team 0803-0807") needs
  #     # no weekly edit here. Closed and future sprints never match.
  #     #
  #     # The prefix is applied to what the query returned, so `limit` has to
  #     # cover the *unfiltered* result: a board with four active sprints needs
  #     # a limit big enough for all four, or the rows you want may never be
  #     # fetched.
  #     sprintPrefix: Team
  #
  # A future sprint used as a named backlog has a fixed name, so it needs no
  # prefix - match it exactly:
  #
  #   - title: Backlog
  #     jql: project = ABC AND sprint = "Team backlog" ORDER BY updated DESC
  #     limit: 40

defaults:
  preview:
    open: true
    position: right
    # 0 < width < 1 is a ratio of the screen width. The preview closes on its
    # own when it would leave the table under 80 columns.
    width: 0.5
  limit: 20

# Every {{...}} value is substituted already shell-quoted, because a Jira
# title is free text and this command is run through `sh -c`. Do NOT add your
# own quotes around a variable — `-n {{.IssueKey}}` is right, `-n "{{.IssueKey}}"`
# would put literal quote marks in the window name.
keybindings:
  issues:
    #: 課題をブラウザで開く
    - key: o
      command: open {{.IssueURL}}
    #: 課題を Claude に渡して調査を始める（新しい tmux ウィンドウ）
    - key: R
      command: >-
        tmux new-window -n {{.IssueKey}}
        claude --permission-mode auto {{.IssueKey}}

theme:
  colors: # Dracula
    text:
      primary: "#f8f8f2"
      secondary: "#6272a4"
    background:
      selected: "#44475a"
    border:
      primary: "#bd93f9"
